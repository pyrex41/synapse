{
  "$id": "report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "report"
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "description": "Portfolio company name"
    },
    "report_month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Report month in YYYY-MM format"
    },
    "report_type": {
      "type": "string",
      "enum": ["company", "portfolio", "analytics"],
      "description": "Type of report: company-specific, portfolio-wide assessment, or analytics/BI report"
    },
    "companies_included": {
      "type": "array",
      "description": "List of portfolio companies included in this portfolio report (only for report_type: portfolio)",
      "items": {
        "type": "string"
      }
    },
    "portfolio_health_summary": {
      "type": "object",
      "description": "Aggregate health metrics across portfolio (only for report_type: portfolio)",
      "properties": {
        "excellent_count": {
          "type": "integer",
          "minimum": 0
        },
        "good_count": {
          "type": "integer",
          "minimum": 0
        },
        "fair_count": {
          "type": "integer",
          "minimum": 0
        },
        "poor_count": {
          "type": "integer",
          "minimum": 0
        },
        "critical_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_active_initiatives": {
          "type": "integer",
          "minimum": 0
        },
        "total_critical_risks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cross_portfolio_themes": {
      "type": "array",
      "description": "Key themes and patterns identified across portfolio companies (only for report_type: portfolio)",
      "items": {
        "type": "string"
      }
    },
    "overall_health": {
      "type": "string",
      "enum": ["excellent", "good", "fair", "poor", "critical"],
      "description": "Overall health rating for the company"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Deal team's confidence in current trajectory"
    },
    "active_initiatives_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of active initiatives"
    },
    "critical_risks_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of critical risks"
    },
    "board_attention_required": {
      "type": "boolean",
      "description": "Whether this report contains items requiring board attention"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date/time when report was generated"
    },
    "data_source_meeting_notes": {
      "type": "array",
      "description": "List of meeting note document IDs used as source data",
      "items": {
        "type": "string"
      }
    },
    "brand_theme": {
      "type": "string",
      "enum": ["nexa", "millstone"],
      "default": "nexa",
      "description": "Brand theme to use for report styling (nexa for PE firm reports, millstone for consultant-only reports)"
    },
    "consultant_attribution": {
      "type": "string",
      "default": "Millstone Partners LLC",
      "description": "Consultant name for footer attribution"
    }
  },
  "required": [
    "type",
    "company",
    "report_month",
    "report_type"
  ],
  "additionalProperties": false,
  "x-synapse": {
    "folder": "80_Reports",
    "displayLabel": "Report",
    "cmsCollection": "reports"
  }
}
