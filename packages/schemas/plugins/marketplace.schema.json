{
  "$id": "marketplace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Code Plugin Marketplace Schema",
  "description": "Schema for validating Claude Code plugin marketplace manifests",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "description": "Marketplace name in kebab-case"
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$",
      "description": "Semver version string"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Brief description of the marketplace"
    },
    "repository": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["type", "url"],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1,
            "description": "Plugin name in kebab-case"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "source": {
            "type": "string",
            "pattern": "^\\./",
            "description": "Relative path to plugin directory, must start with ./"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": ["name", "description", "source", "tags"],
        "additionalProperties": false
      }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX license identifier or custom license name"
    }
  },
  "required": [
    "name",
    "owner",
    "version",
    "description",
    "repository",
    "plugins",
    "license"
  ],
  "additionalProperties": false
}
