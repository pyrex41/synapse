{
  "adr": {
    "$id": "adr.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^ADR-\\d{4,}$"
      },
      "type": {
        "const": "adr"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "review",
          "approved",
          "deprecated",
          "proposed",
          "accepted",
          "superseded"
        ]
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "updated": {
        "type": "string",
        "format": "date-time"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      },
      "example": {
        "type": "boolean"
      },
      "supersedes": {
        "type": "string"
      },
      "superseded_by": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "type",
      "title",
      "status",
      "owner",
      "created",
      "updated"
    ],
    "additionalProperties": false
  },
  "agreement": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Independent Contractor Agreement",
    "type": "object",
    "required": [
      "id",
      "type",
      "title",
      "status",
      "owner",
      "effective_date",
      "parties",
      "compensation",
      "governing_law",
      "venue",
      "signatures"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "agreement"
      },
      "title": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "owner": {
        "type": "string"
      },
      "created": {
        "type": "string"
      },
      "updated": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "effective_date": {
        "type": "string"
      },
      "parties": {
        "type": "object",
        "required": [
          "client",
          "contractor"
        ],
        "properties": {
          "client": {
            "type": "object",
            "required": [
              "name",
              "state",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "contractor": {
            "type": "object",
            "required": [
              "name",
              "state",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          }
        }
      },
      "compensation": {
        "type": "object",
        "required": [
          "total"
        ],
        "properties": {
          "total": {
            "type": "number"
          },
          "in_kind": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "description",
                "fair_market_value",
                "delivery"
              ],
              "properties": {
                "description": {
                  "type": "string"
                },
                "fair_market_value": {
                  "type": "number"
                },
                "delivery": {
                  "type": "string"
                }
              }
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "amount",
                "trigger",
                "due_days"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "trigger": {
                  "type": "string"
                },
                "due_days": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "termination": {
        "type": "object",
        "properties": {
          "convenience": {
            "type": "object",
            "properties": {
              "notice_days": {
                "type": "number"
              }
            }
          }
        }
      },
      "governing_law": {
        "type": "string"
      },
      "venue": {
        "type": "string"
      },
      "signatures": {
        "type": "object",
        "required": [
          "client_signatory",
          "contractor_signatory"
        ],
        "properties": {
          "client_signatory": {
            "type": "string"
          },
          "contractor_signatory": {
            "type": "string"
          }
        }
      }
    },
    "additionalProperties": false
  },
