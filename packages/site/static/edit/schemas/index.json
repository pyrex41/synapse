  "reference": {
    "$id": "reference.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "const": "reference"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Title of the reference document"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "archived"
        ],
        "description": "Status of the reference document"
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "updated": {
        "type": "string",
        "format": "date-time"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string",
        "description": "Brief description or excerpt"
      },
      "example": {
        "type": "boolean"
      },
      "upstream_url": {
        "type": "string",
        "format": "uri",
        "description": "Source URL where this reference content originates"
      },
      "source_prefix": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Manual override for source prefix in filename (e.g., 'claude-code', 'dora'). Only needed if automatic extraction from upstream_url fails or needs customization."
      },
      "last_synced": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp of when content was last synchronized from upstream"
      },
      "attribution": {
        "type": "string",
        "minLength": 1,
        "description": "Original author or organization"
      },
      "license": {
        "type": "string",
        "minLength": 1,
        "description": "License under which the upstream content is distributed"
      },
      "upstream_version": {
        "type": "string",
        "description": "Version or commit hash from upstream source (optional)"
      },
      "category": {
        "type": "string",
        "enum": [
          "documentation",
          "api-reference",
          "blog-post",
          "standard",
          "specification",
          "tutorial",
          "other"
        ],
        "description": "Category of external reference"
      }
    },
    "required": [
      "id",
      "type",
      "title",
      "status",
      "owner",
      "created",
      "updated",
      "upstream_url",
      "last_synced"
    ],
    "additionalProperties": false
  },
