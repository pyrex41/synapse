              "type": "string"
            },
            "due_date": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "risk",
            "severity",
            "likelihood"
          ]
        }
      },
      "action_plan": {
        "type": "array",
