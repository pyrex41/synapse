  "reference": {
    "$id": "reference.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-synapse": {
      "folder": "200_References",
      "displayLabel": "Reference",
      "cmsCollection": "references"
    },
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "const": "reference"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Title of the reference document"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "archived"
        ],
        "description": "Status of the reference document"
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "updated": {
        "type": "string",
        "format": "date-time"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string",
        "description": "Brief description or excerpt"
      },
      "example": {
        "type": "boolean"
      },
      "upstream_url": {
        "type": "string",
        "format": "uri",
        "description": "Source URL where this reference content originates"
      },
      "source_prefix": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Manual override for source prefix in filename (e.g., 'claude-code', 'dora'). Only needed if automatic extraction from upstream_url fails or needs customization."
      },
      "last_synced": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp of when content was last synchronized from upstream"
      },
      "attribution": {
        "type": "string",
        "minLength": 1,
        "description": "Original author or organization"
      },
      "license": {
        "type": "string",
        "minLength": 1,
        "description": "License under which the upstream content is distributed"
      },
      "upstream_version": {
        "type": "string",
        "description": "Version or commit hash from upstream source (optional)"
      },
      "category": {
        "type": "string",
        "enum": [
          "documentation",
          "api-reference",
          "blog-post",
          "standard",
          "specification",
          "tutorial",
          "other"
        ],
        "description": "Category of external reference"
      }
    },
    "required": [
      "id",
      "type",
      "title",
      "status",
      "owner",
      "created",
      "updated",
      "upstream_url",
      "last_synced"
    ],
    "additionalProperties": false
  },
  "report": {
    "$id": "report.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "const": "report"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "review",
          "approved",
          "deprecated",
          "proposed",
          "accepted",
          "superseded"
        ]
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "updated": {
        "type": "string",
        "format": "date-time"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      },
      "example": {
        "type": "boolean"
      },
      "company": {
        "type": "string",
        "minLength": 1,
        "description": "Portfolio company name"
      },
      "report_month": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "description": "Report month in YYYY-MM format"
      },
      "report_type": {
        "type": "string",
        "enum": [
          "company",
          "portfolio",
          "analytics"
        ],
        "description": "Type of report: company-specific, portfolio-wide assessment, or analytics/BI report"
      },
      "companies_included": {
        "type": "array",
        "description": "List of portfolio companies included in this portfolio report (only for report_type: portfolio)",
        "items": {
          "type": "string"
        }
      },
      "portfolio_health_summary": {
        "type": "object",
        "description": "Aggregate health metrics across portfolio (only for report_type: portfolio)",
        "properties": {
          "excellent_count": {
            "type": "integer",
            "minimum": 0
          },
          "good_count": {
            "type": "integer",
            "minimum": 0
          },
          "fair_count": {
            "type": "integer",
            "minimum": 0
          },
          "poor_count": {
            "type": "integer",
            "minimum": 0
          },
          "critical_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_active_initiatives": {
            "type": "integer",
            "minimum": 0
          },
          "total_critical_risks": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "cross_portfolio_themes": {
        "type": "array",
        "description": "Key themes and patterns identified across portfolio companies (only for report_type: portfolio)",
        "items": {
          "type": "string"
        }
      },
      "overall_health": {
        "type": "string",
        "enum": [
          "excellent",
          "good",
          "fair",
          "poor",
          "critical"
        ],
        "description": "Overall health rating for the company"
      },
      "confidence": {
