{
  "name": "@millstone/synapse-context-mcp",
  "version": "0.7.0",
  "description": "MCP server for Synapse framework - provides context management, code structure extraction, and Claude Code integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "context-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc; node bundle-continue.js",
    "build:verbose": "tsc",
    "build:bundle": "node bundle-continue.js",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:continue-compat": "vitest run --reporter=verbose tests/continue-compat/",
    "prepublishOnly": "npm run build:clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/millstonehq/synapse.git",
    "directory": "packages/context-mcp"
  },
  "homepage": "https://github.com/millstonehq/synapse#readme",
  "bugs": {
    "url": "https://github.com/millstonehq/synapse/issues"
  },
  "keywords": [
    "synapse",
    "mcp",
    "context",
    "code-structure",
    "ai"
  ],
  "author": "Millstone",
  "license": "MIT",
  "dependencies": {
    "@continuedev/core": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "glob": "^11.0.0",
    "ignore": "^6.0.2",
    "tiktoken": "^1.0.17"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
