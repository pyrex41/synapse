{
  "name": "@millstone/synapse-context-mcp",
  "version": "0.7.2",
  "description": "MCP server for file reading, context selection, and token counting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "context-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/millstonehq/synapse.git",
    "directory": "packages/context-mcp"
  },
  "homepage": "https://github.com/millstonehq/synapse#readme",
  "bugs": {
    "url": "https://github.com/millstonehq/synapse/issues"
  },
  "keywords": [
    "synapse",
    "mcp",
    "context",
    "ai"
  ],
  "author": "Millstone",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "glob": "^11.1.0",
    "ignore": "^6.0.2",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
