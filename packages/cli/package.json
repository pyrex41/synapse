{
  "name": "@millstone/synapse-cli",
  "version": "0.5.2",
  "description": "Synapse documentation framework CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "synapse": "./bin/synapse.js"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "templates/**/*",
    "README.md"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:integration": "npm test",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "coverage:report": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageReporters=text --coverageReporters=html",
    "install-hooks": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/millstonehq/synapse.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/millstonehq/synapse#readme",
  "bugs": {
    "url": "https://github.com/millstonehq/synapse/issues"
  },
  "keywords": [
    "synapse",
    "documentation",
    "validation",
    "cli",
    "markdown"
  ],
  "dependencies": {
    "@millstone/synapse-schemas": "*",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.0.1",
    "playwright-chromium": "^1.40.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "^6.0.0",
    "turndown": "^7.2.2",
    "unified": "^11.0.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.0",
    "@types/jsdom": "^21.1.0",
    "@types/json-schema": "^7.0.0",
    "@types/mdast": "^4.0.3",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
