{
  "name": "@millstone/synapse-cli",
  "version": "0.7.2",
  "description": "Synapse documentation framework CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "synapse": "./bin/synapse.js"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "templates/**/*",
    "README.md"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:integration": "npm test",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "coverage:report": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageReporters=text --coverageReporters=html",
    "install-hooks": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/millstonehq/synapse.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/millstonehq/synapse#readme",
  "bugs": {
    "url": "https://github.com/millstonehq/synapse/issues"
  },
  "keywords": [
    "synapse",
    "documentation",
    "validation",
    "cli",
    "markdown"
  ],
  "dependencies": {
    "@millstone/synapse-schemas": "*",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "chalk": "^5.6.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^4.3.2",
    "jsdom": "^27.4.0",
    "mermaid": "^12.0.0",
    "parse5": "^8.0.1",
    "playwright-chromium": "^1.63.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/json-schema": "^7.0.15",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/turndown": "^5.0.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
